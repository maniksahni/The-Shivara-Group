# MySQL database URL. On Railway, reference the database service's MYSQL_URL.
# Example Railway value: ${{MySQL-2sfV.MYSQL_URL}}
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Public production domain.
NEXTAUTH_URL="https://shivara.site"
NEXT_PUBLIC_SITE_URL="https://shivara.site"
SITE_URL="https://shivara.site"

# Admin email used by prisma db seed to create/update the CRM admin user.
CRM_ADMIN_EMAIL=""

# Password used when prisma db seed creates/updates the admin user.
SEED_ADMIN_PASSWORD=""

# Optional: comma-separated emails allowed as sales agents.
# Set this to Shivam Sahni's real login email if his CRM account email is known.
# Leave blank if the CRM user name is exactly "Shivam Sahni" / "Shivam Sahani".
CRM_SALES_AGENT_EMAILS=""
